{
  "manifest_version": 3,
  "name": "Model Token Usage Monitor",
  "version": "0.1.0",
  "description": "统一查看 Antigravity、Gemini Web、腾讯云 TokenHub 与鹅厂 Token的模型 Token / 配额使用率。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "模型 Token 调用率",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "cookies",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "webRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://aicode.clients6.google.com/*",
    "https://antigravity.google.com/*",
    "https://*.google.com/*",
    "https://gemini.google.com/*",
    "https://tokenhub.tencentcloudapi.com/*",
    "https://token.woa.com/*",
    "https://www.gstatic.com/*"
  ]
}
